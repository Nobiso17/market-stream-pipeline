# Alpaca market data API (free tier) - https://alpaca.markets/
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# Which symbols to stream, comma separated
SYMBOLS=AAPL,MSFT,TSLA,NVDA,SPY

# Kafka/Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=stock-ticks

# Postgres warehouse (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=market_data
POSTGRES_USER=market
POSTGRES_PASSWORD=market

# Where the consumer archives raw JSON (stands in for an S3 bucket)
RAW_ARCHIVE_DIR=./raw_archive
